#!/usr/bin/env bats

@test "teevisor open" {
    run gcc open.c -o test_open
    run ./test_open
    [ "$status" -eq 0 ]
    [ "$output" != "Failed to open /dev/teevisor" ]
}

@test "teevisor mmap" {
    run gcc mmap.c -o test_mmap
    run ./test_mmap
    [ "$status" -eq 0 ]
    [ "$output" = "fd is mapped to 0x0 - 0x200000" ]
}

@test "teevisor ecreate normal" {
    run gcc ecreate_normal.c -o test_ecreate_normal
    run ./test_ecreate_normal
    echo "ret value is $status"
    [ "$status" -eq 0 ]
}

teardown() {
  rm test_*
}